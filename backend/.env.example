# Flask Environment Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-super-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=1440

# Database Configuration (SQLite default for local dev, PostgreSQL compatible)
DATABASE_URL=sqlite:///d:/05_JKT/backend/instance/jktyre.db

# Storage
UPLOAD_FOLDER=d:/05_JKT/backend/uploads
MAX_CONTENT_LENGTH=16777216

# Rate Limiting & Security
RATE_LIMIT_ENABLED=true
DEMO_MODE=true
SYNTHETIC_DATA_ENABLED=true
